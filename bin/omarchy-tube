#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ELECTRON_BIN="$SCRIPT_DIR/node_modules/electron/dist/electron"

if [ ! -x "$ELECTRON_BIN" ]; then
    echo "Fel: Electron hittades inte i $ELECTRON_BIN." >&2
    exit 1
fi

exec "$ELECTRON_BIN" "$SCRIPT_DIR/src/main.js" \
    --name="OmarchyTube" \
    --class="OmarchyTube" \
    --ozone-platform=wayland \
    --disable-vulkan \
    --enable-features=VaapiVideoDecodeLinuxGL,VaapiVideoDecoder \
    "$@"
